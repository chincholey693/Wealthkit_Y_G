# ============================================
# WEALTHKIT — ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in values
# ============================================

# SUPABASE (get from supabase.com → project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# NEXTAUTH (generate secret: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# GOOGLE OAUTH (console.cloud.google.com → APIs → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RESEND EMAIL (resend.com → API Keys)
RESEND_API_KEY=re_your-resend-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# RAZORPAY (razorpay.com → Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# APP CONFIG
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WealthKit
